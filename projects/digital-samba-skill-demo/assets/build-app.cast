[0.028, "o", "\u001b[?2026h\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\r\n\u001b[38;2;78;186;101m⏺\u001b[39m \u001b[1mWrite\u001b[22m(~/work/digital-samba-interview-room-demo/src/lib/room-codes.ts)\r\n  ⎿  Wrote \u001b[1m44\u001b[22m lines to \u001b[1m../src/lib/room-codes.ts\u001b[22m                                     \u001b(B\r\n     \u001b[32m// Simple in-memory store for room codes (in production, use a database)\u001b[39m\r\n     \u001b[34mconst\u001b[39m roomCodeStore = \u001b[34mnew\u001b[39m \u001b[36mMap\u001b[39m<\u001b[36mstring\u001b[39m, { \u001b[36mroomId\u001b[39m: \u001b[36mstring\u001b[39m; createdAt: \u001b[36mnumber\u001b[39m }>();\r\n     \u001b[34mexport\u001b[39m \u001b[34mfunction\u001b[33m generateRoomCode(): string \u001b[39m{\r\n       \u001b[34mconst\u001b[39m chars = \u001b[31m'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'\u001b[39m;\r\n       \u001b[34mlet\u001b[39m code = \u001b[31m''\u001b[39m;\r\n       \u001b[34mfor\u001b[39m (\u001b[34mlet\u001b[39m i = \u001b[32m0\u001b[39m; i < \u001b[32m6\u001b[39m; i++) {\r\n         code += chars.charAt(\u001b[36mMath\u001b[39m.floor(\u001b[36mMath\u001b[39m.random() * chars.length));\r\n       }\r\n       \u001b[34mreturn\u001b[39m code;\r\n     \u001b[38;2;153;153;153m… +34 lines (ctrl+o to expand"]
